---
import type { Content, Locale } from '../content/types.ts'
import Icon from './Icon.astro'
import Shot from './Shot.astro'
import { PROVIDERS_DOC } from '../content/site.ts'

interface Props {
  c: Content
  locale: Locale
}
const { c, locale } = Astro.props
const f = c.features
const pv = f.providers
---

<section class="sec" id="features" aria-labelledby="features-title">
  <div class="c">
    <div class="sec-head">
      <h2 id="features-title">{f.title}</h2>
      <p>{f.lead}</p>
    </div>

    <ul class="feat">
      {f.items.map((item) => (
        <li>
          <span class="ic">
            <Icon name={item.icon} />
          </span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </ul>
    <p class="feat-note">{f.locales}</p>

    <div class="providers" id="providers">
      <h3 class="block-title">
        {pv.title}
        <span class="src-tag">{pv.sourceTag}</span>
      </h3>
      <p class="block-lead">{pv.lead}</p>
      <div class="provider-notes">
        <div>
          <h4>{pv.stepsTitle}</h4>
          <ol class="steps">
            {pv.steps.map((t) => (
              <li>{t}</li>
            ))}
          </ol>
          <p class="range">{pv.probeNote}</p>
          <p class="range">{pv.rangeNote}</p>
          <p class="range">
            <a class="textlink" href={PROVIDERS_DOC}>
              {pv.docsLabel}
            </a>
          </p>
        </div>
        <div>
          <h4>{pv.accountTitle}</h4>
          <p class="range">{pv.accountLead}</p>
          <dl class="notes">
            {pv.account.map((a) => (
              <div>
                <dt>{a.name}</dt>
                <dd>{a.text}</dd>
              </div>
            ))}
          </dl>
          <h4 class="second">{pv.optionsTitle}</h4>
          <dl class="notes">
            {pv.options.map((o) => (
              <div>
                <dt>{o.title}</dt>
                <dd>{o.text}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </div>

    <div class="screens" id="screens">
      <h3 class="block-title">{f.screensTitle}</h3>
      <p class="block-lead">{f.screensNote}</p>
      <div class="screen-grid">
        {f.screens.map((s) => (
          <figure class="screen">
            <div class="frame">
              <Shot
                locale={locale}
                shot={s.shot}
                alt={s.alt}
                sizes="(min-width: 760px) 520px, calc(100vw - 32px)"
              />
            </div>
            <figcaption>
              <b>{s.title}</b>
              <span>{s.text}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>

    <div class="styles" id="styles">
      <h3 class="block-title">{f.stylesTitle}</h3>
      <p class="block-lead">{f.stylesLead}</p>
      <div class="pg">
        {f.styleGroups.map((g) => (
          <div>
            <h4>{g.name}</h4>
            <ul class="chips">
              {g.styles.map((p) => (
                <li class="chip">{p}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
