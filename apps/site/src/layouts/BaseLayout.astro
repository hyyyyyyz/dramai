---
import '../styles/fonts.css'
import '../styles/tokens.css'
import '../styles/base.css'
import '../styles/sections.css'
import { fontPreloads } from '../lib/fonts.ts'
import { absoluteUrl, PUBLISHED_VERSION } from '../content/site.ts'
import type { Locale } from '../content/types.ts'
import Sprite from '../components/Sprite.astro'

interface Props {
  lang: string
  locale: Locale
  title: string
  description: string
  /** Path of this page inside the site, without base: "" or "en/". */
  path?: string
  ogAlt?: string
  /** Text of the first screen's headings, used to preload only the font slices it needs. */
  preloadText?: string
  noindex?: boolean
  /** Pages that exist in both languages get hreflang alternates. */
  alternates?: boolean
  bodyClass?: string
}

const {
  lang,
  locale,
  title,
  description,
  path = '',
  ogAlt = '',
  preloadText = '',
  noindex = false,
  alternates = true,
  bodyClass,
} = Astro.props

const canonical = absoluteUrl(path)
const og = absoluteUrl(`og-${locale}.png`)
const ogLocale = locale === 'zh' ? 'zh_CN' : 'en_US'
const ogLocaleAlt = locale === 'zh' ? 'en_US' : 'zh_CN'
const preloads = fontPreloads(preloadText)

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'dramai',
  applicationCategory: 'MultimediaApplication',
  operatingSystem: 'macOS, Windows, Linux',
  softwareVersion: PUBLISHED_VERSION,
  license: 'https://www.apache.org/licenses/LICENSE-2.0',
  isAccessibleForFree: true,
  description,
  url: canonical,
  inLanguage: lang,
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates && (
      <>
        <link rel="alternate" hreflang="zh-CN" href={absoluteUrl('')} />
        <link rel="alternate" hreflang="en" href={absoluteUrl('en/')} />
        <link rel="alternate" hreflang="x-default" href={absoluteUrl('')} />
      </>
    )}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#F9F6F1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#100E0C" media="(prefers-color-scheme: dark)" />

    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} sizes="48x48" />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}favicon-180.png`} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="dramai" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:locale" content={ogLocale} />
    {alternates && <meta property="og:locale:alternate" content={ogLocaleAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    <meta name="twitter:image:alt" content={ogAlt} />

    {preloads.map((href) => (
      <link rel="preload" as="font" type="font/woff2" href={href} crossorigin="anonymous" />
    ))}

    <!-- Applies a theme chosen earlier before first paint. Without JS the system setting decides. -->
    <script is:inline>
      try {
        const t = localStorage.getItem('dramai-site-theme')
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t)
      } catch {
        // storage can be blocked; the system colour scheme decides then
      }
    </script>
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class={bodyClass}>
    <Sprite />
    <slot />
  </body>
</html>
