{
  "name": "@dramai/ui",
  "private": true,
  "version": "0.5.0-beta.1",
  "type": "module",
  "description": "dramai shared UI: primitives, brand assets and design tokens (Tailwind v4)",
  "license": "Apache-2.0",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles/globals.css": "./src/styles/globals.css",
    "./brand/*": "./src/brand/*",
    "./v2": "./src/v2/index.ts",
    "./v2/styles.css": "./src/v2/styles.css",
    "./v2/theme.css": "./src/v2/styles/theme.css",
    "./v2/fonts.css": "./src/v2/styles/fonts.css",
    "./v2/base.css": "./src/v2/styles/base.css"
  },
  "scripts": {
    "dev": "vite --config preview/vite.config.ts",
    "build": "vite build --config preview/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build:fonts": "node scripts/build-fonts.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "catalog:",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "catalog:",
    "tailwindcss-animate": "^1.0.7"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@dramai/eslint-config": "workspace:*",
    "@dramai/tsconfig": "workspace:*",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "catalog:",
    "jsdom": "^31.0.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "^8.3.6",
    "vitest": "catalog:"
  }
}
