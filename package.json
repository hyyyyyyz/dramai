{
  "name": "dramai-monorepo",
  "private": true,
  "version": "0.5.0-beta.1",
  "type": "module",
  "description": "An open-source AI short-drama studio that runs on your own computer: give it a novel or a script and it plans episodes, scenes and shots, generates images and video through the AI providers you choose, and composes a finished cut with narration and subtitles.",
  "keywords": [
    "ai",
    "short-drama",
    "storyboard",
    "video",
    "react",
    "vite",
    "openai"
  ],
  "author": "hyyyyyyz",
  "license": "Apache-2.0",
  "homepage": "https://github.com/hyyyyyyz/dramai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyyyyyyz/dramai.git"
  },
  "bugs": {
    "url": "https://github.com/hyyyyyyz/dramai/issues"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "pnpm --filter @dramai/workspace dev",
    "dev:demo": "pnpm --filter @dramai/workspace dev --demo",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "lint:fix": "pnpm -r --if-present lint:fix",
    "preview": "pnpm --filter @dramai/workspace preview",
    "demo": "pnpm --filter @dramai/mock-providers demo",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --no-bail --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "webui": "pnpm --filter @dramai/webui start",
    "e2e": "pnpm --filter @dramai/workspace e2e",
    "version:bump": "node --experimental-strip-types --disable-warning=ExperimentalWarning tooling/release/src/cli.ts bump",
    "version:suggest": "node --experimental-strip-types --disable-warning=ExperimentalWarning tooling/release/src/cli.ts suggest",
    "version:set": "node --experimental-strip-types --disable-warning=ExperimentalWarning tooling/release/src/cli.ts set",
    "version:check": "node --experimental-strip-types --disable-warning=ExperimentalWarning tooling/release/src/cli.ts check",
    "desktop:dev": "pnpm --filter @dramai/desktop dev",
    "desktop:build": "pnpm --filter @dramai/desktop app:build",
    "desktop:install": "pnpm --filter @dramai/desktop install:local",
    "desktop:uninstall": "pnpm --filter @dramai/desktop uninstall:local",
    "desktop:check-install": "pnpm --filter @dramai/desktop check:install",
    "desktop:dist": "pnpm --filter @dramai/desktop dist"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
