{
  "name": "dramai-monorepo",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "description": "Open-source AI short-drama studio. Turn docs / images / a sentence into a structured storyboard, images, and video clips — all powered by OpenAI-compatible APIs.",
  "keywords": [
    "ai",
    "short-drama",
    "storyboard",
    "video",
    "react",
    "vite",
    "openai"
  ],
  "author": "hyyyyyyz",
  "license": "Apache-2.0",
  "homepage": "https://hyyyyyyz.github.io/dramai/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hyyyyyyz/dramai.git"
  },
  "bugs": {
    "url": "https://github.com/hyyyyyyz/dramai/issues"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --filter @dramai/workspace dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "lint:fix": "pnpm -r --if-present lint:fix",
    "preview": "pnpm --filter @dramai/workspace preview",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}
